NODE_ENV=development
PORT=4000
# Supabase > Connect > Server. These values stay on the API server.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-your-secret-key
JWT_SECRET=replace-with-a-long-random-secret
PIN_PEPPER=replace-with-a-second-long-random-secret
PUBLIC_ORIGIN=http://localhost:5173
# No PostgreSQL connection string, publishable key or JWKS URL is needed.
